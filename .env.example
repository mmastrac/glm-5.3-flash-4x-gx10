# Copy to compose/.env (not the repo root): docker compose reads .env from the
# compose file's directory. Only per-host and per-node values belong here.
# Every tuned knob has its default in image/entrypoint.sh, and a copy here
# silently wins over the measured value -- which happened three times on
# 2026-08-27.

# --- required, the same on every node ---------------------------------------
# An image built from this tree. An older tag carries older entrypoint defaults.
IMAGE=spark-glm53:v8
# The head's LAN address; every rank's mentat agent dials it.
HEAD_HOST=192.0.2.10
# Fabric address prefix, with the trailing dot.
CLUSTER_SUBNET=10.0.0.
# Host paths. Weights must be on each node's local disk: every rank reads the
# whole checkpoint, and an NFS mount races the network at boot.
MODEL_HOST_DIR=/srv/models/glm-5.3-flash-nvfp4-nvidia
DFLASH_HOST_DIR=/srv/models/glm-5.3-flash-dflash2
EXT_DIR=/srv/ext
CACHE_HOME=/srv/container-cache
LOG_DIR=/srv/logs

# --- required, per node -------------------------------------------------------
# head on one node, worker on the rest.
ROLE=head
# This node's LAN address, the one its mentat daemon connects from.
VLLM_HOST_IP=192.0.2.10

# --- optional ------------------------------------------------------------------
# One prefix per ConnectX PCIe root for NCCL, space-separated and quoted. Both
# roots made a 126k prefill 40% faster at TP=4. Empty = CLUSTER_SUBNET only.
#FABRIC_SUBNETS="10.0.0. 10.0.1."
# Per node. Empty = the interface holding VLLM_HOST_IP.
#NCCL_SOCKET_IFNAME=
# Per node. mentat's agent id is group@container@node_ip; defaults to glm53.
#CONTAINER_NAME=glm53-w
# Empty = port form (8002/v1, 8082/mcp). Set a URL only to pin one address.
#MENTAT_MCP_API=
#MENTAT_OPENAI_API=
