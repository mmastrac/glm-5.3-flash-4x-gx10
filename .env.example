# Copy to .env on every node. ROLE is the only value that differs between them;
# everything else is identical across the cluster.
# --- per node ---
# ROLE is the only value that differs between nodes. vLLM's own address is NOT
# set here: the entrypoint waits for whichever interface carries CLUSTER_SUBNET
# and uses that, so a rewire or an interface rename does not need an edit.
ROLE=head                       # head on one node, worker on the rest

# --- paths ---
# Everything the compose files mount lives under SPARK_HOME. Set both if your
# account is not `admin`; .env is not a shell, so MODEL_HOST_DIR cannot refer
# to SPARK_HOME and has to be spelled out.
SPARK_HOME=/home/admin
# These three have their own defaults under /home/admin and compose cannot nest
# substitutions, so set them too if SPARK_HOME is not /home/admin.
CACHE_HOME=/home/admin/container-cache
EXT_DIR=/home/admin/ext
LOG_DIR=/home/admin/logs

# --- cluster ---
TP=4
CLUSTER_SUBNET=10.100.0.        # the RoCE fabric; vLLM's address is derived from it
# Every node registers with the head's daemon, not its own. Pointing a node at
# its local mentatd (127.0.0.1) does not work today: the registration reaches
# the head but the liveness does not, so the head reports the agent dead and the
# GPU gate waits forever on `have 1`. See Troubleshooting.
HEAD_HOST=192.168.1.93          # same value on every node, including the head
IMAGE=glm53-spark:sm90-v21
MODEL_HOST_DIR=/home/admin/models/glm-5.3-flash-nvfp4-rh
NCCL_SOCKET_IFNAME=enP7s7       # LAN iface; NCCL derives the RoCE HCA itself

# --- serving ---
MAX_MODEL_LEN=524288
MAX_NUM_SEQS=32
MAX_NUM_BATCHED_TOKENS=16384
LONG_PREFILL_TOKEN_THRESHOLD=2304   # MUST be a multiple of the 2304 KDA block
CUDAGRAPH_CAPTURE_SIZES=8 16 32 64 96 128 192 256
MOE_BACKEND=                        # empty = marlin
GPU_MEM_UTIL=0.88                   # 0.90 wedges the box after a few hours
NCCL_MAX_NCHANNELS=8
SPEC_TOKENS=3
MTP=1
SAFETENSORS_LOAD_STRATEGY=eager
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
TORCH_MEM_FRACTION=0.92
LIMIT_MM={"image":16,"video":0}
